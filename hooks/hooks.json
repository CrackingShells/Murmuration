{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/user_words.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/resume_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/budget.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/budget.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/handback.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=; while IFS= read -r l || [ -n \"$l\" ]; do p=$p$l; done; case $p in *'\"agent_id\"'*) printf '%s\\n' \"$p\" | python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/budget.py\";; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/handback.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/handback.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/budget.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=; while IFS= read -r l || [ -n \"$l\" ]; do p=$p$l; done; case $p in *'\"agent_id\"'*) printf '%s\\n' \"$p\" | python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/budget.py\";; esac",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
