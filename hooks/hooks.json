{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/user_words.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/resume_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\" || echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SubagentStart\", \"additionalContext\": \"Hooks down: python3 cannot run the hook scripts of the lab. The budget notes, the 150% block and the hand-back capture are not running for this run. Go on; start your hand-back with a line `HOOKS DOWN: <what you saw>`.\"}}'",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}"
            },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\"",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}"
            },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "last_assistant_message": "${last_assistant_message}"
            },
            "timeout": 3
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_calls": "${tool_calls}"
            },
            "timeout": 3
          }
        ]
      }
    ]
  }
}
