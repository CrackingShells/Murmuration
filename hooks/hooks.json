{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/user_words.py"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/install_binary.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/resume_brief.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "budget"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/.claude/settings*.json)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/managed-settings*)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/managed-settings.d/**)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.py)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.sh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.bash)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.zsh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.js)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.ts)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/*.mjs)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/.claude/settings*.json)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/managed-settings*)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/managed-settings.d/**)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.py)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.sh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.bash)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.zsh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.js)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.ts)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/*.mjs)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/.claude/settings*.json)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/managed-settings*)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/managed-settings.d/**)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.py)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.sh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.bash)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.zsh)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.js)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.ts)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.mjs)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "NotebookEdit(**/*.ipynb)",
            "command": "${CLAUDE_PLUGIN_DATA}/bin/murmuration",
            "args": [
              "guard"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "budget"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "handback"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "budget"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "handback"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "handback"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "budget"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py",
              "budget"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
