{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/user_words.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/resume_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\" || echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SubagentStart\", \"additionalContext\": \"Hooks down: python3 cannot run the hook scripts of the lab. The budget notes, the 150% block and the hand-back capture are not running for this run. Go on; start your hand-back with a line `HOOKS DOWN: <what you saw>`.\"}}'",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*bypass*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*dangerously*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources p*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources l*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources -*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources=p*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources=l*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*--setting-sources=))",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*claude*--bare*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*claude*--safe-mode*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*disableAllHooks*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*CLAUDE_CONFIG_DIR=*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*tee *settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*cp *settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*mv *settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*rm *settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*sed *-i*settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*open(*settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*writeFile*settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/.claude/settings*.json)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/managed-settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Write(**/managed-settings.d/**)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/.claude/settings*.json)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/managed-settings*)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Edit(**/managed-settings.d/**)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permission_guard.py\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\"",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}"
            },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/outage.py\"",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}"
            },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "handback",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "last_assistant_message": "${last_assistant_message}"
            },
            "timeout": 3
          },
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:murmuration:hooks",
            "tool": "hook",
            "input": {
              "script": "budget",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "transcript_path": "${transcript_path}",
              "agent_transcript_path": "${agent_transcript_path}",
              "permission_mode": "${permission_mode}",
              "tool_calls": "${tool_calls}"
            },
            "timeout": 3
          }
        ]
      }
    ]
  }
}
