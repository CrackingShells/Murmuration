{
 "hooks": {
  "PostToolBatch": [
   {
    "hooks": [
     {
      "type": "http",
      "url": "http://127.0.0.1:62406/hang",
      "headers": {
       "X-W7C-Token": "$W7C_TOKEN"
      },
      "allowedEnvVars": [
       "W7C_TOKEN"
      ],
      "timeout": 3,
      "onFailure": "block"
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" truth --dump /private/tmp/murmuration-w07/explorer-w07-c/runs/batch_hang/truth.jsonl"
     }
    ]
   }
  ]
 }
}