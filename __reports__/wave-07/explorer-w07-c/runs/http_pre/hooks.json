{
 "hooks": {
  "PreToolUse": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" truth --dump /private/tmp/murmuration-w07/explorer-w07-c/runs/http_pre/truth.jsonl"
     }
    ],
    "matcher": "Bash"
   },
   {
    "hooks": [
     {
      "type": "http",
      "url": "http://127.0.0.1:62113/ok",
      "headers": {
       "X-W7C-Token": "$W7C_TOKEN"
      },
      "allowedEnvVars": [
       "W7C_TOKEN"
      ],
      "if": "Bash(echo H-OK*)"
     }
