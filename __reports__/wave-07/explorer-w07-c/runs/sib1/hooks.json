{
 "hooks": {
  "PostToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "python3 -S -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" sib0"
     }
    ]
   }
  ],
  "PreToolUse": [
