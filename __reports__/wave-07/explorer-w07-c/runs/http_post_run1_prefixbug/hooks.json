     }
    ],
    "matcher": "Bash"
   },
   {
    "hooks": [
     {
      "type": "http",
      "url": "http://127.0.0.1:62031/ok",
      "headers": {
       "X-W7C-Token": "$W7C_TOKEN"
      },
      "allowedEnvVars": [
