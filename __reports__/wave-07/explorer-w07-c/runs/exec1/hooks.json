{
 "hooks": {
  "PostToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "python3",
      "args": [
       "-S",
       "-I",
       "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
       "sib0"
      ]
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "python3",
      "args": [
       "-S",
       "-I",
       "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py",
       "sibpre0",
       "--only",
       "SLEEPY",
       "--sleep",
       "0.5"
      ]
     }
    ]
   }
  ]
 }
}