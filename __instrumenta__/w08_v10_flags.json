{
 "note": "w08-c10 verifier data: flag strings the guard must deny after claude (G1 bypass words, G2 settings-sources / bare / safe-mode / disableAllHooks); data only, never run",
 "flags": [
  "--dangerously-skip-permissions",
  "--allow-dangerously-skip-permissions",
  "--permission-mode bypassPermissions",
  "--permission-mode=bypassPermissions",
  "--setting-sources project",
  "--setting-sources=project",
  "--setting-sources local,project",
  "--bare",
  "--safe-mode",
  "--settings '{\"disableAllHooks\":true}'"
 ],
 "assign_attacks": [
  "CLAUDE_CONFIG_DIR=/tmp/x"
 ],
 "g3_writes": [
  "echo '{}' > ~/.claude/settings.json",
  "tee .claude/settings.local.json < in.json",
  "sed -i s/a/b/ .claude/settings.json",
  "cp new.json /Library/Application Support/ClaudeCode/managed-settings.json",
  "rm .claude/settings.json"
 ]
}
