#!/bin/sh
# Dev git hook (not installed by anything): when a commit touches the Python guard or the Rust crate, rebuild the host binary into bin/<target>/ and replay the corpus through both guards.
# Install by hand:  ln -s ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Needs cargo (offline cache is enough: the crate has no dependencies) and python3. Fails the commit on any difference between permission_guard.py and `murmuration guard`.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
if ! git diff --cached --name-only | grep -Eq '^(scripts/permission_guard\.py|rust/|bin/)'; then
  exit 0
fi
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  *) echo "pre-commit: no binary target for this host; skipping the rebuild" >&2; target= ;;
esac
if [ -n "$target" ]; then
  cargo build --release --offline --manifest-path rust/Cargo.toml --target "$target"
  mkdir -p "bin/$target"
  cp "rust/target/$target/release/murmuration" "bin/$target/murmuration"
  git add "bin/$target/murmuration"
fi
# the installer installs a binary only when bin/manifest.json matches the binaries, scripts/permission_guard.py and rust/: write it on every commit that touches any of them
python3 -I scripts/build_manifest.py
git add bin/manifest.json
exec python3 -I scripts/check_guard_equal.py --quick
